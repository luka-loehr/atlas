# Copy to /etc/paperclip-bridge.env and fill in. Never commit the real file:
# it holds the board API key.
#
#   sudo install -m600 -o root -g root paperclip-bridge.env.example \
#        /etc/paperclip-bridge.env
#
# bridge.py reads it via the unit's EnvironmentFile=. The CLIs (ask-luka,
# owner-sweep, paperclip-task, report-to-hermes) read the same names from
# their own environment — export them for whatever runs the agents.

# --- Paperclip, the upstream board API -------------------------------------
# Base URL of the Paperclip server on the tailnet. Required.
PAPERCLIP_API=http://atlas.your-tailnet.ts.net:3100
# Company UUID (paperclipai companies list). Required.
PAPERCLIP_COMPANY=
# Board API key, minted via POST /api/board-api-keys. Required — this is the
# secret in this file.
PAPERCLIP_TOKEN=

# --- The bridge itself ------------------------------------------------------
# Address to listen on. Set it to the tailnet address of this host; the code
# falls back to 127.0.0.1 rather than 0.0.0.0 so a missing value fails closed.
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=3111
# Poll intervals in seconds while the company is idle / running.
BRIDGE_POLL_IDLE=5
BRIDGE_POLL_BUSY=1.5

# --- The agent CLIs ---------------------------------------------------------
# Where ask-luka posts its questions — this bridge. Required for ask-luka.
BRIDGE_URL=http://atlas.your-tailnet.ts.net:3111
# Optional: a separate token for the bridge. Falls back to PAPERCLIP_TOKEN.
BRIDGE_TOKEN=
# Hermes' inbound webhook. Required for report-to-hermes.
HERMES_WEBHOOK_URL=http://atlas.your-tailnet.ts.net:8644/webhooks/<company>
# Signing secret for that webhook. Optional here — report-to-hermes also reads
# ~/.paperclip/hermes-webhook.secret.
HERMES_WEBHOOK_SECRET=
# Optional: what the agent calls itself in asks and reports.
PAPERCLIP_AGENT_NAME=
