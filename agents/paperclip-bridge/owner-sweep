#!/usr/bin/env python3
"""owner-sweep — no task in this company is allowed to have no owner.

Agents discover work while doing other work and file it. Left alone, that
work lands in the backlog with no assignee and sits there forever: nobody is
woken by it, nobody reviews it, and it silently becomes a to-do list nobody
reads.

This runs on a timer. Anything open and unowned — or owned by an agent that
is paused, which is the same thing — goes to the Chief of staff, who is the
one whose job is to triage and delegate. Then it wakes them, so the task is
picked up in minutes rather than at the next heartbeat.

A rule in COMMS.md tells the agents to assign work when they file it. This is
the net under that rule, for the times they forget.
"""

import json
import os
import sys
import urllib.error
import urllib.request

API = os.environ.get("PAPERCLIP_API", "")
COMPANY = os.environ.get("PAPERCLIP_COMPANY", "")
OPEN = ("backlog", "todo", "in_progress", "in_review", "blocked")

TOKEN = os.environ.get("PAPERCLIP_TOKEN", "")
if not TOKEN:
    try:
        TOKEN = open(os.path.expanduser("~/.paperclip/atlas-automation.key")).read().strip()
    except OSError:
        pass


def api(path, payload=None, method="GET"):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        API + path, data=data, method=method,
        headers={"Authorization": "Bearer " + TOKEN, "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.load(resp)


def main() -> int:
    if not API or not COMPANY:
        print("owner-sweep: PAPERCLIP_API and PAPERCLIP_COMPANY must be set "
              "(see /etc/paperclip-bridge.env)", file=sys.stderr)
        return 3
    agents = api(f"/api/companies/{COMPANY}/agents")
    lead = next((a for a in agents if a.get("role") == "ceo"), None)
    if not lead:
        print("owner-sweep: no lead agent — cannot route", file=sys.stderr)
        return 1
    paused = {a["id"] for a in agents if a.get("status") == "paused"}

    issues = api(f"/api/companies/{COMPANY}/issues")
    orphans = [
        i for i in issues
        if i.get("status") in OPEN
        and (not i.get("assigneeAgentId") or i["assigneeAgentId"] in paused)
    ]
    if not orphans:
        return 0

    for issue in orphans:
        why = ("was filed with no owner" if not issue.get("assigneeAgentId")
               else "was assigned to a paused agent")
        api(f"/api/issues/{issue['id']}", {"assigneeAgentId": lead["id"]}, method="PATCH")
        api(f"/api/issues/{issue['id']}/comments", {
            "body": (
                f"Routed to {lead['name']} automatically: this task {why}, and no "
                "task in this company is allowed to sit without one. Triage it — "
                "do it yourself or hand it to the specialist who owns that area, "
                "and set a real status. If it is not worth doing, cancel it and "
                "say why."
            )
        }, method="POST")
        print(f"{issue.get('identifier', issue['id'])}  ->  {lead['name']}  ({why})")

    # wake the lead once, after everything is on their plate
    try:
        api(f"/api/agents/{lead['id']}/heartbeat/invoke", {}, method="POST")
    except urllib.error.URLError:
        pass
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except urllib.error.URLError as exc:
        print(f"owner-sweep: cannot reach Paperclip at {API}: {exc}", file=sys.stderr)
        sys.exit(3)
