# Build output. `target/` is unanchored so it covers the Rust workspace
# wherever cargo is run. `build-sim/` and `build-device/` are the conventional
# -derivedDataPath values used for local simulator and device builds;
# `DerivedData/` is what Xcode writes when it picks the path itself.
target/
build/
build-sim/
build-device/
DerivedData/

# Xcode per-user state. Never shareable, and xcuserdata/ additionally pins
# scheme names, so a stale copy resurrects a renamed scheme as a ghost.
xcuserdata/
*.xcuserstate

# macOS.
.DS_Store

# Secrets compiled into the iOS app. The app does not use the pattern (the
# server address and token are entered at runtime and kept in the keychain);
# the rule is the repo-wide backstop.
Secrets.swift

# Machine configuration and credentials. On the server, db/.env is a SYMLINK
# into /etc/atlas, where the real files live outside the checkout, so
# `git clean -fdx` removes a link, not a running service's credentials.
#
# `*.env` rather than `.env`, so named env files (`something.env`) are
# covered too. `.env.*` adds the suffixed variants (`.env.production`), which
# `*.env` does not match. The negation is what keeps the tracked templates
# visible — without it `.env.*` would swallow `.env.example` as well.
*.env
.env.*
!.env.example
*.local
