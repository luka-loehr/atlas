# On atlas, backend/docker/.env, apps/atlas-photos/pipeline/.env and
# lightshows/artnet_host.local are SYMLINKS into /etc/atlas — the real files
# live outside the checkout so `git clean -fdx` cannot delete them.
# Mapping: docs/SETUP.md section 9.
target/
backend/docker/.env
build-sim/
build-device/
xcuserdata/
apps/atlas-photos/ios/build/
__pycache__/
.DS_Store
*.pyc
# Show media lives in ATLAS_LIGHTSHOW_MEDIA_DIR (default /var/lib/atlas/
# lightshow-media), outside the checkout. Nothing writes here any more; these
# patterns only cover hand-dropped legacy files that the readers still fall
# back to. Every extension audio_file() probes is listed, so such a file is
# ignored rather than merely untracked — plain `git clean -fd` cannot take it.
lightshows/shows/*.mp3
lightshows/shows/*.jpg
lightshows/shows/*.wav
lightshows/shows/*.m4a
lightshows/shows/*.opus
lightshows/shows/*.webm
lightshows/shows/*.aac
lightshows/shows/*.flac
.env
*.local
scripts/atlas-faces/
