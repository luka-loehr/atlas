[Unit]
Description=Clean shutdown on three fast power-button presses
Documentation=file:///home/SET-BY-INSTALLER/atlas/scripts/power-button/README.md
# logind must be up first: it is what ignores the key, leaving it to us.
After=systemd-logind.service

[Service]
Type=simple
# No User= on purpose. This needs to read /dev/input/event* and to call
# `systemctl poweroff`, both of which are root's. A concrete User= is also
# a landmine: naming an account that does not exist on the box crash-loops
# the unit.
# A root-owned copy (install.sh), not the checkout: a root service must not run
# a file that luka, or anything running as luka, can rewrite.
ExecStart=/usr/local/sbin/atlas-power-button
Restart=always
RestartSec=5

# It only ever reads input devices and asks systemd to power off.
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M

[Install]
WantedBy=multi-user.target
