[Unit]
Description=Copy the agentbrain memories to this server
Wants=network-online.target
After=network-online.target
# install.sh fills in the destination from /etc/atlas/agentbrain-backup.env.
RequiresMountsFor=SET-BY-INSTALLER
# With scripts/bulk-backup installed, the [Install] section hooks this into the
# hourly bulk backup, which then waits for it, so each hour's snapshot holds
# that hour's archive; a failed pull does not stop the backup. Without it,
# atlas-agentbrain-backup.timer runs it hourly.
Before=atlas-bulk-backup.service

[Service]
Type=oneshot
# Its own system user: it only ever downloads the archive and writes the
# destination directory.
User=atlas-agentbrain
Group=atlas-agentbrain
EnvironmentFile=/etc/atlas/agentbrain-backup.env
LoadCredential=agentbrain-backup.key:/etc/atlas/credentials/agentbrain-backup.key
ExecStart=/usr/local/bin/atlas-agentbrain-backup
StateDirectory=atlas-agentbrain-backup
StateDirectoryMode=0750
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
ProtectSystem=strict
ReadWritePaths=SET-BY-INSTALLER
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=atlas-bulk-backup.service
