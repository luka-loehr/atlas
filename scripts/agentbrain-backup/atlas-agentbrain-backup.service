[Unit]
Description=Pull the agentbrain archive into /srv/bulk/agentbrain
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/bulk
# No timer of its own: the [Install] section below hooks it into the hourly
# bulk backup, which then waits for it, so each hour's snapshot on the USB disk
# holds that hour's archive. A failed pull does not stop the backup.
Before=atlas-bulk-backup.service
OnFailure=atlas-alert@%n.service

[Service]
Type=oneshot
# Its own system user: it only ever downloads the archive and writes
# /srv/bulk/agentbrain.
User=atlas-agentbrain
Group=atlas-agentbrain
EnvironmentFile=/etc/atlas/agentbrain-backup.env
LoadCredential=agentbrain-backup.key:/etc/atlas/credentials/agentbrain-backup.key
ExecStart=/usr/local/bin/atlas-agentbrain-backup
StateDirectory=atlas-agentbrain-backup
StateDirectoryMode=0750
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
ProtectSystem=strict
ReadWritePaths=/srv/bulk/agentbrain
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=atlas-bulk-backup.service
