[Unit]
Description=Atlas health check on boot (builds green, services up)
Wants=network-online.target
After=network-online.target docker.service atlas-agent.service atlas-photos.service

[Service]
Type=oneshot
User=luka
Environment=ATLAS_HEALTH_RETRIES=12
ExecStart=/home/luka/atlas/scripts/healthcheck/atlas-healthcheck.sh
TimeoutStartSec=20min
Nice=10

[Install]
WantedBy=multi-user.target
