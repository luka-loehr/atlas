[Unit]
Description=Atlas health check on boot (builds green, services up)
Wants=network-online.target
After=network-online.target docker.service atlas-api.service atlas-photos.service

[Service]
Type=oneshot
User=luka
Environment=ATLAS_HEALTH_RETRIES=12
Environment=ATLAS_HEALTH_DIR=/var/lib/atlas/health
ExecStart=/home/luka/atlas/scripts/healthcheck/healthcheck.sh
TimeoutStartSec=20min
Nice=10

[Install]
WantedBy=multi-user.target
