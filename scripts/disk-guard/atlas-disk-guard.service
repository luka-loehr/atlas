[Unit]
Description=Guard against atlas root filling up
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=luka
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=5min
ExecStart=/home/luka/atlas/scripts/disk-guard/disk-guard.sh
# A non-zero exit means critical-or-worse; SuccessExitStatus keeps systemd from
# marking the unit failed for a condition the script reported correctly.
SuccessExitStatus=0 1
