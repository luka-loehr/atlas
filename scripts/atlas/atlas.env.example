# /etc/atlas/atlas.env — read by atlas-server and atlas-ml (mode 0600, root).
# Every variable is documented where it is read: crates/server/src/config.rs,
# crates/ml/src/config.rs, crates/core/src/db.rs.

# Required. Every API route needs it; the app asks for it once.
#   openssl rand -hex 32
ATLAS_TOKEN=

# Required. The same password db/.env gives the Postgres container.
POSTGRES_PASSWORD=

# Where things live (defaults shown).
#ATLAS_PHOTOS_DIR=/home/you/photos        # originals/, thumbs/, faces/
#ATLAS_DRIVE_DIR=/home/you/drive          # blobs/
#ATLAS_PREVIEWS_DIR=/home/you/photos/previews   # video renditions; bulky
#ATLAS_MODELS_DIR=/home/you/models        # see scripts/atlas/models.sh

# Optional.
#ATLAS_BIND=0.0.0.0:8787
#ATLAS_TZ=Europe/Berlin                   # default: the machine's zone
#ATLAS_WORKERS=6                          # 0 = no ingest workers
#ATLAS_VIDEO_PREVIEWS=0                   # skip video renditions
#ATLAS_ML_IDLE_S=600                      # unload the embedding model when idle
