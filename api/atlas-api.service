[Unit]
Description=Atlas API server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# The account the API server runs as. `atlas api` substitutes the account that
# runs the deploy; the sentinel below is never a valid user on purpose, so a
# hand-copied unit fails with "Unknown user: SET-BY-INSTALLER" instead of
# silently pointing at a plausible-but-absent account.
#
# A previous revision shipped `User=atlas` here. There is no `atlas` user on
# the box, so every install crash-looped the service (status=217/USER) with a
# name that reads like it ought to exist. Do not reintroduce a concrete
# username here — substitute it at install time.
#
# Whatever account it ends up as needs the `docker` group for /api/docker, and
# passwordless sudo for exactly `poweroff` and `reboot` if the power endpoints
# should work.
User=SET-BY-INSTALLER
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/local/bin/atlas-api
# Optional env file (may be absent): ATLAS_API_TOKEN (bearer token —
# strongly recommended), ATLAS_API_BIND / ATLAS_API_PORT, and the other
# ATLAS_* overrides (see the README). Without a token the server refuses all
# state-changing routes unless ATLAS_API_OPEN=1 explicitly opts into
# trusting the tailnet/firewall instead.
EnvironmentFile=-/etc/atlas-api.env
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
