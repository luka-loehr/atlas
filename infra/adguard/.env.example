# Copy to .env (gitignored) before `docker compose up`. Both values are
# required — compose hard-fails with either unset, on purpose: a
# wrong-but-plausible fallback would bind the wrong address or scatter state.
ATLAS_TAILNET_IP=100.x.y.z          # this box's tailnet address: tailscale ip -4
ATLAS_ADGUARD_DIR=/home/you/adguard # holds AdGuard's conf/ and work/
