# Art-Net -> Hue lightshow bridge (bridge/hue_stream.py).
# Idles on UDP :6454 until a show starts streaming, takes over the Hue
# entertainment group for the duration, releases it after 180 s of silence.
# Install (renders SET-BY-INSTALLER to your user and $HOME; repo at ~/atlas):
#          . ../../scripts/lib/install-unit.sh && install_unit lightshow-bridge.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now lightshow-bridge
[Unit]
Description=Art-Net to Hue lightshow bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=SET-BY-INSTALLER
WorkingDirectory=/home/SET-BY-INSTALLER/atlas/lightshows/bridge
ExecStart=/usr/bin/python3 -u /home/SET-BY-INSTALLER/atlas/lightshows/bridge/hue_stream.py
# optional: ARTNET_BIND / ARTNET_IDLE_TIMEOUT (file may be absent)
EnvironmentFile=-/etc/lightshow-bridge.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
